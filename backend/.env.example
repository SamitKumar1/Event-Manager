# App
PORT=3000
NODE_ENV=development

# Database (PostgreSQL on host via Docker)
DATABASE_URL=postgresql://event_user:event_pass@localhost:5432/event_platform?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Email mock provider failure mode (set true to force failures for testing)
MOCK_EMAIL_FORCE_FAIL=false

JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=15m
